rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmmdk04@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products: Anyone can read, only admin can create/update/delete
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create, update, delete: if isAdmin();
    }

    // Categories: Anyone can read, only admin can write
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow create, update, delete: if isAdmin();
    }

    // Banners: Anyone can read active banners, admin can manage all
    match /banners/{bannerId} {
      allow read: if isValidId(bannerId);
      allow create, update, delete: if isAdmin();
    }

    // Store Settings & Founder Profile: Public can read, only admin can write
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update, delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Orders:
    // - Customers can CREATE an order if it contains valid customer info and status is 'Pending'
    // - Only admin can read orders list and update status
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 120 &&
        request.resource.data.customerPhone is string &&
        request.resource.data.customerPhone.size() >= 10 &&
        request.resource.data.grandTotal is number &&
        request.resource.data.grandTotal >= 0;

      allow read, update, delete: if isAdmin();
    }
  }
}
